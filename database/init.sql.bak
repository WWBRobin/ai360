-- 5.7 使用指南
INSERT INTO guides (skill_id, content, difficulty_level) VALUES
((SELECT id FROM skills WHERE slug='ecommerce-copy-master'),
 '## 快速上手\n1. 打开扣子进入电商文案大师\n2. 输入商品名称/价格/卖点\n3. 选择目标平台（淘宝/京东/抖音）\n4. 复制生成的文案到商品后台\n\n## 技巧\n- 输入越具体，输出越精准\n- 卖点字段建议 3-5 个关键词',
 'beginner')
ON CONFLICT DO NOTHING;

-- 5.8 横评文章
INSERT INTO comparison_articles (title, slug, scenario_id, content, skills_included, published_at, status) VALUES
('10 个电商文案 Skill 实测对比：谁最能打？', 'ecommerce-copy-showdown',
 (SELECT id FROM scenarios WHERE slug='ecommerce-copy'),
 '## 评测方法\n本文对 10 个电商文案类 Skill 使用同一商品（无线蓝牙耳机）进行 5 次实测，对比生成速度、文案质量、平台覆盖。\n\n## 结论\n- 电商文案大师综合最佳（4.5 分）\n- 短视频脚本助手在抖音口播场景更有优势',
 ARRAY[(SELECT id FROM skills WHERE slug='ecommerce-copy-master'),
       (SELECT id FROM skills WHERE slug='short-video-script')],
 NOW() - INTERVAL '1 day', 'published')
ON CONFLICT (slug) DO NOTHING;

