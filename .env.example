# ============================================================
# AI Skill 评测平台 — 环境变量模板
# 复制为两份：
#   1) 前端（Next.js/Vercel）：cp .env.example .env.local
#   2) 后端（ECS 中转 API）：  cp .env.example backend/.env  （只用到下半部分）
# ============================================================

# ───────────────────────────
# 前端 — Supabase（Vercel 环境变量设置同名字段）
# ───────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ECS 中转试用 API 公网地址（前端 POST /api/trial 用）
NEXT_PUBLIC_TRIAL_API_URL=https://api.vokki.cn

# ───────────────────────────
# 后端 — ECS 中转 API（backend/trial-api.js）
# ───────────────────────────
# 服务端口（ECS 上通常由 Nginx 反代，可保持 3001）
PORT=3001

# 扣子 Coze Chat API 凭证（https://www.coze.cn/open/oauth/pats 创建个人令牌）
COZE_API_TOKEN=pat_xxxxxxxxxxxxxxxx
COZE_API_BASE=https://api.coze.cn

# 每个 sessionToken 每个 Skill 每日免费试用次数
TRIAL_LIMIT_PER_SKILL=5

# 可试用 Skill 注册表（JSON 数组，覆盖内置默认；字段：
# slug/name/provider/apiBase/botId/promptTemplate/placeholder/maxOutputChars）
# 注意：botId 必须是扣子真实 Bot ID（示例数据里的 REPLACE_WITH_BOT_ID_x 为占位符）
TRIAL_SKILLS_JSON=[{"slug":"ecommerce-copy-master","name":"电商文案大师","provider":"coze","apiBase":"https://api.coze.cn","botId":"REPLACE_WITH_BOT_ID_1","promptTemplate":"你是电商文案专家。请根据商品信息生成标题、卖点、详情页文案。商品信息：{{input}}","placeholder":"例如：无线蓝牙耳机 售价199 主打降噪","maxOutputChars":2000}]

# Supabase 持久化（配置后试用日志落库 trial_logs 表 + 配额跨重启生效；
# 不配置则降级为内存配额，重启清零）
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# CORS 允许来源（逗号分隔；前端域名必须在此列表内）
ALLOWED_ORIGINS=http://localhost:3000,https://vokki.cn
